# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and should never be committed.

# Google Gemini API key (server-side only — never use NEXT_PUBLIC_ prefix)
GEMINI_API_KEY=your_gemini_api_key_here

# ── Orange Business email automation (IMAP) ─────────────────────────────────
# Gmail: turn on 2-Step Verification, create an app password, enable IMAP.
# (GMAIL_USER / GMAIL_APP_PASSWORD are accepted too)
MAIL_USER=
MAIL_APP_PASSWORD=
# Defaults shown; change for other providers
MAIL_IMAP_HOST=imap.gmail.com
MAIL_IMAP_PORT=993
MAIL_FOLDER=INBOX
# How far back to look on the very first sync
MAIL_LOOKBACK_DAYS=30
# Comma-separated senders trusted to create/update jobs
MAIL_ALLOWED_SENDERS=noreply@orange.com
# Protects GET /api/mail/sync when called by a scheduler
CRON_SECRET=

# ── Database ─────────────────────────────────────────────────────────────────
# Postgres connection string (e.g. Neon). Leave empty to use the embedded
# database stored in data/pglite.
DATABASE_URL=

# ── Sign-in ──────────────────────────────────────────────────────────────────
# Signs session cookies. At least 32 random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
# Lets the first admin be created on a hosted deployment (local copies don't need it)
SETUP_CODE=

# ── Daily digest and alerts ──────────────────────────────────────────────────
# Sent from MAIL_USER over Gmail SMTP. By default the digest goes to active
# admin and finance users and alerts go to admins; these override that.
DIGEST_TO=
ALERT_TO=
# Public address used in email links (defaults to the Vercel production URL)
APP_URL=
